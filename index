function shuffle(a){a=[...a];for(let i=a.length-1;i>0;i--){let j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a}
function speak(w){if(!('speechSynthesis'in window)){alert('此瀏覽器不支援朗讀。');return}speechSynthesis.cancel();let u=new SpeechSynthesisUtterance(w);u.lang='en-US';u.rate=.8;speechSynthesis.speak(u)}
function render(){ $('#count').textContent=state.known.length;$('#progress').style.width=state.known.length+'%';$('#units').innerHTML=DATA.map((u,i)=>`<button class="${unit===i?'active':''}" data-unit="${i}"><small>UNIT 0${i+1} · ${u.words.filter(w=>state.known.includes(w.id)).length}/20 熟悉</small>${esc(u.words[0].en)} — ${esc(u.words.at(-1).en)}</button>`).join('');document.querySelectorAll('[data-unit]').forEach(b=>b.onclick=()=>{unit=+b.dataset.unit;game=null;pos=0;flipped=false;quiz=null;render()});$('#tabs').innerHTML=[['cards','單字翻卡'],['choice','選擇練習'],['spell','拼字練習'],['review','錯題複習'],['match','翻卡對碰'],['list','單字總覽']].map(([m,t])=>`<button class="${mode===m?'active':''}" data-mode="${m}">${t}${m==='review'?' ('+state.wrong.length+')':''}</button>`).join('');document.querySelectorAll('[data-mode]').forEach(b=>b.onclick=()=>{mode=b.dataset.mode;game=null;pos=0;quiz=null;flipped=false;render()});if(mode==='cards'||mode==='review')cards();else if(mode==='list')list();else if(mode==='match')matching();else exercise()}
function cards(){let words=mode==='review'?ALL.filter(w=>state.wrong.includes(w.id)):DATA[unit].words;if(!words.length){$('#content').innerHTML='<h2>目前沒有待複習的錯題</h2><p>完成選擇或拼字練習後，答錯的單字會出現在這裡。</p>';return}pos%=words.length;let w=words[pos];$('#content').innerHTML=`<div class="topline"><b>${mode==='review'?'跨單元錯題本':'UNIT 0'+(unit+1)}</b><span class="muted">${pos+1} / ${words.length}</span></div><button class="card" id="flip" aria-label="翻卡查看${flipped?'英文':'中文'}"><span class="${flipped?'meaning':'word'}">${esc(flipped?w.zh:w.en)}</span><span class="muted">${flipped?'點一下回到英文':'先回想意思，再點一下翻卡'}</span></button>${flipped?exampleHTML(w):''}<div class="actions"><button id="prev">上一字</button><button id="speak">聽發音</button><button id="next">下一字</button></div><div class="actions" style="margin-top:15px"><button id="known" class="primary">${state.known.includes(w.id)?'取消熟悉標記':'我已熟悉這個字'}</button>${mode==='review'?'<button id="remove">移出錯題本</button>':''}</div>`;$('#flip').onclick=()=>{flipped=!flipped;cards()};$('#prev').onclick=()=>{pos=(pos+words.length-1)%words.length;flipped=false;cards()};$('#next').onclick=()=>{pos=(pos+1)%words.length;flipped=false;cards()};$('#speak').onclick=()=>speak(w.en);bindExamples();$('#known').onclick=()=>{state.known=state.known.includes(w.id)?state.known.filter(id=>id!==w.id):[...state.known,w.id];save();render()};if($('#remove'))$('#remove').onclick=()=>{state.wrong=state.wrong.filter(id=>id!==w.id);save();render()}}
function exercise(){if(!quiz){$('#content').innerHTML=`<div class="tag">PRACTICE / UNIT 0${unit+1}</div><h2>${mode==='choice'?'英文選中文':'看中文拼英文'}</h2><p>從本單元隨機抽出 10 個單字。送出後會顯示正解，答錯的字會加入錯題本。</p><div class="help">${mode==='spell'?'英文大小寫不計分；連字號請依原表輸入。':'依照教材中的中文釋義，選出正確答案。'}</div><button class="primary" id="start">開始 10 題練習</button><p class="muted">已完成 ${state.scores.length} 次測驗</p>`;$('#start').onclick=()=>{quiz={words:shuffle(DATA[unit].words).slice(0,10),index:0,score:0,answered:false};exercise()};return}if(quiz.index===quiz.words.length){$('#content').innerHTML=`<div class="tag">SESSION COMPLETE</div><h2>這次答對 ${quiz.score} / ${quiz.words.length} 題</h2><p>答錯的字已加入錯題本。再看一次，會更有印象。</p><button id="again" class="primary">再練一次</button> <button id="review">前往錯題複習</button>`;$('#again').onclick=()=>{quiz=null;exercise()};$('#review').onclick=()=>{mode='review';pos=0;flipped=false;render()};return}let w=quiz.words[quiz.index];$('#content').innerHTML=`<div class="topline"><b>${mode==='choice'?'選擇練習':'拼字練習'}</b><span>第 ${quiz.index+1} / 10 題</span></div><div class="card"><span class="${mode==='choice'?'word':'meaning'}">${esc(mode==='choice'?w.en:w.zh)}</span></div><div id="answer"></div><div class="feedback" role="status" id="feedback"></div><button id="continue" class="primary" hidden>下一題</button>`;if(mode==='choice'){let options=shuffle([w.zh,...shuffle([...new Set(ALL.map(x=>x.zh))].filter(t=>t!==w.zh)).slice(0,3)]);$('#answer').innerHTML='<div class="options">'+options.map((t,i)=>`<button data-answer="${i}">${esc(t)}</button>`).join('')+'</div>';document.querySelectorAll('[data-answer]').forEach(b=>b.onclick=()=>{grade(options[+b.dataset.answer]===w.zh,w);document.querySelectorAll('[data-answer]').forEach(x=>{x.disabled=true;if(options[+x.dataset.answer]===w.zh)x.classList.add('correct')});if(options[+b.dataset.answer]!==w.zh)b.classList.add('wrong')})}else{$('#answer').innerHTML='<form id="form"><label for="spelling">輸入英文單字</label><input id="spelling" autocomplete="off" autocapitalize="off" spellcheck="false" required><button style="margin-top:12px" class="primary">送出答案</button></form>';$('#form').onsubmit=e=>{e.preventDefault();if(!$('#spelling').value.trim())return;grade($('#spelling').value.trim().toLowerCase()===w.en.toLowerCase(),w);$('#spelling').disabled=true;$('#form button').disabled=true};$('#spelling').focus()}$('#continue').onclick=()=>{quiz.index++;quiz.answered=false;exercise()}}
function grade(ok,w){if(quiz.answered)return;quiz.answered=true;if(ok)quiz.score++;else if(!state.wrong.includes(w.id))state.wrong.push(w.id);$('#feedback').textContent=(ok?'答對了！':'再記一次：')+w.en+' → '+w.zh;$('#feedback').insertAdjacentHTML('beforeend',exampleHTML(w));bindExamples();$('#continue').hidden=false;$('#continue').textContent=quiz.index===9?'查看成績':'下一題';if(quiz.index===9)state.scores.push({date:new Date().toISOString(),unit:DATA[unit].name,mode,score:quiz.score,total:10});save();$('#tabs [data-mode="review"]').textContent='錯題複習 ('+state.wrong.length+')'}
function list(){ $('#content').innerHTML='<h2>100 字單字總覽</h2><label for="search">搜尋英文或中文</label><input id="search" placeholder="例如：flower 或 花"><div id="rows"></div>';function rows(){let q=$('#search').value.trim().toLowerCase(),a=ALL.filter(w=>(w.en+' '+w.zh).toLowerCase().includes(q));$('#rows').innerHTML=`<p class="muted">找到 ${a.length} 字</p><table><thead><tr><th>英文</th><th>中文釋義</th><th>朗讀</th></tr></thead><tbody>${a.map(w=>`<tr><td>${esc(w.en)}${state.known.includes(w.id)?' ✓':''}</td><td>${esc(w.zh)}<details><summary>看例句</summary>${exampleHTML(w)}</details></td><td><button data-speak="${w.id}" aria-label="朗讀 ${esc(w.en)}">播放</button></td></tr>`).join('')}</tbody></table>`;document.querySelectorAll('[data-speak]').forEach(b=>b.onclick=()=>speak(ALL.find(w=>w.id===b.dataset.speak).en));bindExamples()}$('#search').oninput=rows;rows()}

function exampleHTML(w){return `<div class="example"><span class="tag">簡單例句</span><p class="en" lang="en">${esc(w.example)}</p><p>${esc(w.translation)}</p>${w.note?`<p class="muted">${esc(w.note)}</p>`:''}<button data-example="${w.id}">聽例句</button></div>`}
function bindExamples(){document.querySelectorAll('[data-example]').forEach(b=>b.onclick=()=>speak(ALL.find(w=>w.id===b.dataset.example).example))}
function matching(){
 if(!game){$('#content').innerHTML=`<div class="tag">PLAY & LEARN / UNIT 0${unit+1}</div><h2>翻卡對碰</h2><p>翻開兩張卡片，找出相同意思的「英文＋中文」。配對成功後，一起讀例句！</p><div class="game-settings"><label for="pairs">每回合</label><select id="pairs"><option value="4">4 組 · 入門</option><option value="6">6 組 · 挑戰</option></select></div><p class="muted">沒有時間限制。沒配對成功也沒關係，可以慢慢記住位置。</p><button class="primary" id="play">開始遊戲</button>`;$('#play').onclick=()=>{const n=+$('#pairs').value, words=shuffle(DATA[unit].words).slice(0,n);game={tiles:shuffle(words.flatMap(w=>[{id:w.id,side:'en',text:w.en},{id:w.id,side:'zh',text:w.zh}])),open:[],matched:[],turns:0,n,message:'翻開第一張卡片。',last:null};matching()};return}
 const g=game,done=g.matched.length===g.n;
 $('#content').innerHTML=`<div class="topline"><h2>翻卡對碰</h2><span>已配對 ${g.matched.length} / ${g.n} 組</span></div><p class="muted">已嘗試 ${g.turns} 次 · 不計時</p><div class="game-status" role="status">${esc(g.message)}</div><div class="game-grid">${g.tiles.map((t,i)=>{const matched=g.matched.includes(t.id),shown=matched||g.open.includes(i);return `<button data-tile="${i}" class="tile ${matched?'matched':shown?'':'back'}" ${matched||g.open.includes(i)||g.open.length===2?'disabled':''} aria-label="第 ${i+1} 張卡，${shown?esc(t.text):'未翻開'}">${shown?esc(t.text):'?'}${matched?'<small style="display:block">配對成功 ✓</small>':''}</button>`}).join('')}</div>${g.open.length===2?'<button id="close-pair" class="primary">記住了，蓋回卡片</button>':''}${g.last?exampleHTML(ALL.find(w=>w.id===g.last)):''}${done?'<div class="help"><b>全部配對成功！</b><p>再讀一次例句，把單字放進生活裡。</p></div>':''}<button id="new-game">${done?'再玩一回合':'重新選擇難度'}</button>`;
 document.querySelectorAll('[data-tile]').forEach(b=>b.onclick=()=>{const i=+b.dataset.tile;if(g!==game||g.open.length===2||g.open.includes(i)||g.matched.includes(g.tiles[i].id))return;g.open.push(i);g.last=null;if(g.open.length===1)g.message='再翻一張，找出它的英文或中文。';else{g.turns++;const [a,b]=g.open.map(j=>g.tiles[j]);if(a.id===b.id&&a.side!==b.side){g.matched.push(a.id);g.open=[];g.last=a.id;g.message=g.matched.length===g.n?'太好了，你完成這一回合！':'配對成功！讀讀例句，再找下一組。'}else g.message='這兩張不是一組。先記住位置，再按「蓋回卡片」。'}matching()});
 if($('#close-pair'))$('#close-pair').onclick=()=>{g.open=[];g.message='再試一次，你可以慢慢找。';matching()};$('#new-game').onclick=()=>{game=null;matching()};bindExamples();
}

$('#export').onclick=()=>{let report={exportedAt:new Date().toISOString(),known:ALL.filter(w=>state.known.includes(w.id)),review:ALL.filter(w=>state.wrong.includes(w.id)),scores:state.scores};let url=URL.createObjectURL(new Blob([JSON.stringify(report,null,2)],{type:'application/json'})),a=document.createElement('a');a.href=url;a.download='學習紀錄.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)};$('#reset').onclick=()=>{if(confirm('確定清除這個瀏覽器中的熟悉標記、錯題與測驗成績？')){state={known:[],wrong:[],scores:[]};quiz=null;save();render()}};render();
</script></html>
